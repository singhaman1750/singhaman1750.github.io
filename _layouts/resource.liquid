---
layout: default
---

<!-- Layout for pages under _resources/, generated by bin/sync_resources.py -->

<style type="text/css">
  .resource-page article table {
    display: block;
    width: 100%;
    overflow-x: auto;
    white-space: nowrap;
  }
  .resource-page article ol > li,
  .resource-page article ul > li {
    margin-bottom: 0.6rem;
  }
  .resource-source {
    font-size: 0.85rem;
    color: var(--global-text-color-light);
  }
</style>

<div class="post resource-page">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">
      <a href="{{ '/resources/' | relative_url }}">&larr; All resources</a>
    </p>
  </header>

  <article>
    {{ content }}
  </article>

  <hr />

  <p class="resource-source">
    Mirrored from
    <a href="{{ page.source_url }}" target="_blank" rel="noopener noreferrer">{{ page.source_path }}</a>
    in the
    <a href="{{ site.data.resources.repo_url }}" target="_blank" rel="noopener noreferrer">Legged-Robots</a>
    repository, where corrections and additions are welcome.
  </p>
</div>
